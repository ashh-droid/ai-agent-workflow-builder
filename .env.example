# Next.js client-side Nhost connection
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-project-subdomain
NEXT_PUBLIC_NHOST_REGION=your-project-region
NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://YOUR_SUBDOMAIN.graphql.YOUR_REGION.nhost.run/v1

# Server-only values are configured in Nhost, never exposed with NEXT_PUBLIC_.
# See .secrets.example for local Nhost development.
